# Copy this file to .env and fill in real values.
#   copy .env.example .env
# Never commit .env — it is gitignored.

# Gemini (default profile / Azure live API) — free tier
GEMINI_API_KEY=your-gemini-api-key-here
# Higher free daily quota than gemini-3.8-flash (~20 RPD)
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# text-embedding-004 is retired; gemini-embedding-001 is current
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Ollama (local only): set SPRING_PROFILES_ACTIVE=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.2

# Optional overrides (defaults match local docker-compose)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hr_assistant
# SPRING_DATASOURCE_USERNAME=hr_user
# SPRING_DATASOURCE_PASSWORD=hr_pass
# JWT_SECRET=acme-hr-assistant-dev-secret-change-me-32chars-min
